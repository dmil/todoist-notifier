# Required: Get your API token from https://developer.ticktick.com/
TICKTICK_API_KEY=your_api_token_here

# Display settings (optional - defaults shown)
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480
DISPLAY_FULLSCREEN=false
DISPLAY_FONT_SIZE=24
# Colour scheme: dark (default, easier on the eyes) or light
DISPLAY_THEME=dark
REFRESH_INTERVAL=300

# Webhook settings (optional)
# The TickTick Open API does not support webhooks, so leave this disabled
# unless you are running your own bridge that POSTs to /webhook.
WEBHOOK_ENABLED=false
WEBHOOK_PORT=5000
WEBHOOK_HOST=0.0.0.0

# Task selection (optional)
FOCUS_TAG=@focus
